description: Blade + Bootstrap 5.3; UI clara; sin lógica de negocio en vistas; data-cy
globs:
  - "laravel/resources/views/**/*.blade.php"
  - "laravel/resources/js/**/*.js"
  - "laravel/resources/css/**/*.css"
alwaysApply: true
